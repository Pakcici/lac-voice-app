<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LAC Voice"
        android:textSize="26sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/actionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Mulai" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Belum dimulai."
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Cukup tekan Mulai sekali, lalu main LAC seperti biasa. App tersambung otomatis saat kamu masuk game dan putus otomatis saat kamu keluar. Tombol melayang: ketuk = mic nyala/mati, tekan lama = buka app ini."
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Tips: matikan penghematan baterai untuk app ini (Pengaturan, Baterai) supaya suara tetap jalan saat kamu bermain."
        android:textSize="13sp" />
</LinearLayout>
